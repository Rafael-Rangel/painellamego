{
  "name": "lamego-compras-interno",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @lamego/api run dev",
    "dev:web": "npm --workspace @lamego/web run dev",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "npm --workspace @lamego/shared run build",
    "build:api": "npm --workspace @lamego/api run build",
    "build:web": "npm --workspace @lamego/web run build",
    "test": "npm --workspace @lamego/api run test",
    "test:receipt-ai": "node scripts/test-receipt-ai.mjs",
    "test:receipt-ai:blank-danfe": "node scripts/test-receipt-ai.mjs scripts/fixtures/blank-danfe-template.png --empty-catalog --json",
    "test:receipt-ai:cupom-padaria": "RECEIPT_TEST_CATALOG=\"$(cat scripts/fixtures/cupom-padaria-catalog.json)\" node scripts/test-receipt-ai.mjs scripts/fixtures/cupom-padaria-pao-vovo.png --json",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:push:remote": "bash scripts/supabase-db-push-remote.sh",
    "db:env": "bash -c 'source scripts/supabase-env.sh && echo DB_URL=db.${SUPABASE_PROJECT_REF}.supabase.co'",
    "db:apply-pending": "node scripts/apply-pending-migrations.mjs",
    "db:link": "supabase link --project-ref hfxqvitixkrqjggkbbej",
    "db:wipe-remote": "node scripts/db-wipe-remote.mjs",
    "supabase:bootstrap": "node scripts/setup-supabase.mjs",
    "supabase:bootstrap:admin": "node scripts/setup-supabase.mjs --admin-only"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "supabase": "2.98.2"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
