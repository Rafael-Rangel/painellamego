# Variáveis usadas pelo container `api` em produção (docker-compose).
# Copie para `.env.production` (gitignored) e preencha os segredos reais.

SUPABASE_URL=https://hfxqvitixkrqjggkbbej.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_-3Y6m7X-FhGrQdaFTaZqEA_q_wZ6vlS
SUPABASE_SERVICE_ROLE_KEY=__preencher__
SUPABASE_JWKS_URL=https://hfxqvitixkrqjggkbbej.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=hfxqvitixkrqjggkbbej

# Senha do banco do Supabase (Project Settings > Database)
# Necessária para o container `backup` rodar pg_dump.
SUPABASE_DB_PASSWORD=__preencher__

JWT_AUDIENCE=authenticated
JWT_ISSUER=

# Leitura de nota fiscal (OpenRouter — modelo Google com visão)
OPENROUTER_API_KEY=__preencher__
OPENROUTER_MODEL=google/gemini-2.5-pro
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_HTTP_REFERER=https://painellamego.com.br
OPENROUTER_APP_TITLE=Lamego Compras
# Opcional: timeout por pedido ao OpenRouter na leitura de NF (ms). Evita pedido pendente indefinido.
# OPENROUTER_FETCH_TIMEOUT_MS=120000

# Domínios permitidos no CORS (separe por vírgula se houver mais de 1)
APP_ORIGIN=https://painellamego.com.br

NODE_ENV=production
PORT=3333
HOST=0.0.0.0
TRUST_PROXY=1
