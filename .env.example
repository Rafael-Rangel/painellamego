SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=preencha-com-a-senha-do-banco
JWT_AUDIENCE=authenticated
JWT_ISSUER=
APP_ORIGIN=http://localhost:5173
PORT=3333

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_API_URL=http://localhost:3333
VITE_BRAND_LOGO_URL=/logo.jpg

# Leitura de nota fiscal por IA (OpenRouter). Chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo com visão + JSON; padrão no código: google/gemini-2.0-flash-001
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Se o principal falhar (ex.: Provider returned error em PNG), tenta este modelo. Vazio = desliga; none/off = desliga
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
# Opcionais recomendados pela OpenRouter
OPENROUTER_HTTP_REFERER=https://painellamego.com.br
OPENROUTER_APP_TITLE=Lamego Compras
